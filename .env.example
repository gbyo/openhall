NODE_ENV=development
APP_BASE_URL=http://localhost:3000
DATABASE_URL=postgresql://openhall:openhall-development-only@localhost:5432/openhall
APP_SECRET=development-only-change-this-secret-32-characters
# Durable AES-256-GCM key for OIDC client secrets (exactly 256 bits: 64 hex
# chars or base64 of 32 bytes). DEVELOPMENT-ONLY value below. Generate a
# fresh production key with: openssl rand -hex 32
DATA_ENCRYPTION_KEY=GENERATE-A-FRESH-KEY-WITH-openssl-rand-hex-32
DATA_ENCRYPTION_KEY_ID=development-only-key-1
TRUST_PROXY=false
PORT=3000

{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenHall API",
    "description": "Self-hosted school presence and movement platform API.",
    "version": "0.1.0"
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "__Host-openhall_session",
        "description": "Opaque server-side session bearer (development: openhall_session_dev)."
      },
      "csrfHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-CSRF-Token",
        "description": "Per-session CSRF token from GET /api/v1/auth/session."
      }
    },
    "schemas": {}
  },
  "paths": {
    "/health/live": {
      "get": {
        "operationId": "getLiveness",
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "operationId": "getReadiness",
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "status",
                    "database",
                    "migration"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ready"
                      ]
                    },
                    "database": {
                      "type": "string",
                      "enum": [
                        "ready"
                      ]
                    },
                    "migration": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "503": {
            "description": "A required dependency is unavailable or not current.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "type",
                    "title",
                    "status",
                    "code",
                    "requestId"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "format": "uri-reference"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer",
                      "minimum": 400,
                      "maximum": 599
                    },
                    "detail": {
                      "type": "string"
                    },
                    "instance": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "requestId": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false,
                  "title": "ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/system/info": {
      "get": {
        "operationId": "getSystemInfo",
        "tags": [
          "system"
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "name",
                    "version",
                    "apiVersion",
                    "status"
                  ],
                  "properties": {
                    "name": {
                      "type": "string",
                      "enum": [
                        "OpenHall"
                      ]
                    },
                    "version": {
                      "type": "string"
                    },
                    "apiVersion": {
                      "type": "string",
                      "enum": [
                        "v1"
                      ]
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "foundation"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/session": {
      "get": {
        "operationId": "getAuthSession",
        "tags": [
          "auth"
        ],
        "description": "Returns the current session. Anonymous callers receive authenticated:false.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "type": "object",
                      "required": [
                        "authenticated"
                      ],
                      "properties": {
                        "authenticated": {
                          "type": "boolean",
                          "enum": [
                            false
                          ]
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": [
                        "authenticated",
                        "csrfToken",
                        "absoluteExpiresAt",
                        "authenticationMethod"
                      ],
                      "properties": {
                        "authenticated": {
                          "type": "boolean",
                          "enum": [
                            true
                          ]
                        },
                        "csrfToken": {
                          "type": "string",
                          "minLength": 1
                        },
                        "absoluteExpiresAt": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "authenticationMethod": {
                          "anyOf": [
                            {
                              "type": "string",
                              "enum": [
                                "oidc"
                              ]
                            },
                            {
                              "type": "string",
                              "enum": [
                                "recovery"
                              ]
                            }
                          ]
                        }
                      },
                      "additionalProperties": false
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/me": {

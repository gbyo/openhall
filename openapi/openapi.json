    "/api/v1/auth/discovery": {
      "get": {
        "operationId": "getAuthDiscovery",
        "tags": [
          "auth"
        ],
        "description": "Public login metadata. Returns tenant/provider display info for a single-tenant installation or a known slug; otherwise requires tenant selection without enumerating slugs.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63
            },
            "in": "query",
            "name": "tenant",
            "required": false
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "anyOf": [
                    {
                      "type": "object",
                      "required": [
                        "tenantSelectionRequired"
                      ],
                      "properties": {
                        "tenantSelectionRequired": {
                          "type": "boolean",
                          "enum": [
                            true
                          ]
                        }
                      },
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "required": [
                        "tenantSelectionRequired",
                        "tenant",
                        "providers"
                      ],
                      "properties": {
                        "tenantSelectionRequired": {
                          "type": "boolean",
                          "enum": [
                            false
                          ]
                        },
                        "tenant": {
                          "type": "object",
                          "required": [
                            "id",
                            "name",
                            "slug"
                          ],
                          "properties": {
                            "id": {
                              "type": "string",
                              "format": "uuid"
                            },
                            "name": {
                              "type": "string"
                            },
                            "slug": {
                              "type": "string",
                              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                              "maxLength": 63
                            }
                          },
                          "additionalProperties": false
                        },
                        "providers": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": [
                              "key",
                              "displayName"
                            ],
                            "properties": {
                              "key": {
                                "type": "string",
                                "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
                                "maxLength": 63
                              },
                              "displayName": {
                                "type": "string"
                              }
                            },
                            "additionalProperties": false
                          }
                        }
                      },
                      "additionalProperties": false
                    }
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/oidc/{tenantSlug}/{providerKey}/start": {
      "get": {
        "operationId": "startOidcLogin",
        "tags": [
          "auth"
        ],
        "description": "Starts an OIDC Authorization Code + PKCE (S256) login. Responds 302 to the provider authorization URL. Status documented: 302 success; 400/502 problem on failure.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "maxLength": 2048
            },
            "in": "query",
            "name": "return_path",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63
            },
            "in": "path",
            "name": "tenantSlug",
            "required": true
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63
            },
            "in": "path",
            "name": "providerKey",
            "required": true
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the provider authorization URL",
            "headers": {
              "Location": {
                "schema": {
                  "schema": {
                    "type": "string"
                  }
                },
                "description": "Redirect target"
              },
              "Set-Cookie": {
                "schema": {
                  "schema": {
                    "type": "string"
                  }
                },
                "description": "Fresh login-transaction binding cookie (HttpOnly, SameSite=Lax)"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "description": "Redirect to the provider authorization URL"
                }
              }
            }
          },
          "400": {
            "description": "Login cannot start",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "type",
                    "title",
                    "status",
                    "code",
                    "requestId"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "format": "uri-reference"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer",
                      "minimum": 400,
                      "maximum": 599
                    },
                    "detail": {
                      "type": "string"
                    },
                    "instance": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "requestId": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "502": {
            "description": "Provider unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "type",
                    "title",
                    "status",
                    "code",
                    "requestId"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "format": "uri-reference"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer",
                      "minimum": 400,
                      "maximum": 599
                    },
                    "detail": {
                      "type": "string"
                    },
                    "instance": {
                      "type": "string"
                    },
                    "code": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "requestId": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/oidc/callback": {
      "get": {
        "operationId": "completeOidcLogin",
        "tags": [
          "auth"
        ],
        "description": "OIDC callback. Always responds 302: success redirects to the safe local return path with a fresh HttpOnly session cookie; failure redirects to /?error=<code> with a safe machine-readable code. OIDC protections (state/browser binding/nonce/PKCE/replay) apply instead of the SPA CSRF header.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "maxLength": 512
            },
            "in": "query",
            "name": "state",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 4096
            },
            "in": "query",
            "name": "code",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 200
            },
            "in": "query",
            "name": "error",
            "required": false
          },
          {
            "schema": {
              "type": "string",
              "maxLength": 2048
            },
            "in": "query",
            "name": "iss",
            "required": false
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the return path (success) or /?error=<code> (failure)",
            "headers": {
              "Location": {
                "schema": {
                  "schema": {
                    "type": "string"
                  }
                },
                "description": "Redirect target"
              },
              "Set-Cookie": {
                "schema": {
                  "schema": {
                    "type": "string"
                  }
                },
                "description": "Fresh session cookie on success (HttpOnly, SameSite=Lax)"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "description": "Redirect to the return path (success) or /?error=<code> (failure)"
                }
              }
            }
          }
        }
      }
    },
